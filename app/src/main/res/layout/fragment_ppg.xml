<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_cyan"
    android:orientation="vertical">

    <!-- ── Non-scrolling Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- Back Button -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/card_background"
            android:layout_marginBottom="14dp"
            android:elevation="3dp"
            android:outlineProvider="bounds"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                android:tint="#06B6D4" />
        </FrameLayout>

        <!-- PPG Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="#CFFAFE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Icon + Title row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_cyan"
                        android:layout_marginEnd="14dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ppg"
                            android:tint="#FFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PPG Signal"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photoplethysmography"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2 stat tiles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Average -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_ppg_stat_tile"
                        android:paddingVertical="16dp">
                        <TextView
                            android:id="@+id/tvPpgAverage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="87"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#06B6D4"
                            android:lineSpacingExtra="-2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="AVERAGE"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Quality -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_ppg_quality_tile"
                        android:paddingVertical="16dp">
                        <TextView
                            android:id="@+id/tvPpgQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="94%"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#10B981"
                            android:lineSpacingExtra="-2dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="QUALITY"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── Scrollable Content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- ── Period Selector ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_period_selector"
                android:padding="5dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnPeriodDaily"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Daily"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPeriodWeekly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Weekly"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_period_tab_selected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPeriodMonthly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Monthly"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ── Signal Trend Chart Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeColor="#CFFAFE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Chart header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ppg" android:tint="#06B6D4" android:layout_marginEnd="8dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Signal Trend" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot_green" android:layout_marginEnd="5dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/success" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Trend chart -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartPpgTrend"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Stats Grid (3 tiles) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Avg tile -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeColor="#CFFAFE"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_stat_icon_cyan_light" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_trending_up" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvPpgStatAvg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="87" android:textSize="28sp" android:textStyle="bold" android:textColor="#06B6D4" android:lineSpacingExtra="-2dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="AVG" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Peak tile -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeColor="#D1FAE5"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_stat_icon_green_light" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_zap" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvPpgStatPeak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="92" android:textSize="28sp" android:textStyle="bold" android:textColor="#10B981" android:lineSpacingExtra="-2dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="PEAK" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Low tile -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeColor="#FEF3C7"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_stat_icon_amber_light" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_pulse" android:tint="#F59E0B" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvPpgStatLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="82" android:textSize="28sp" android:textStyle="bold" android:textColor="#F59E0B" android:lineSpacingExtra="-2dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="LOW" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ── What is PPG? Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ppg_info_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_cyan" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_ppg" android:tint="#FFFFFF" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="What is PPG?" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Photoplethysmography (PPG) is an optical technique used to detect blood volume changes in the microvascular bed of tissue."
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="It's commonly used in pulse oximeters and heart rate monitors to measure oxygen saturation and heart rate."
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- ── Real-time Waveform (secondary) ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeColor="#CFFAFE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Real-time Waveform" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvSignalQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_normal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="90% Quality"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/badge_normal_text" />
                    </LinearLayout>

                    <!-- Waveform chart -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartPpgWaveform"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/bg_ppg_waveform" />

                    <!-- Heart Rate + SpO2 row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_reading_mini_tile" android:padding="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heart Rate" android:textSize="11sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tvPpgHeartRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="72 BPM" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_reading_mini_tile" android:padding="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SpO2" android:textSize="11sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tvPpgSpo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="98%" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hidden kept for backwards compatibility -->
            <ProgressBar android:id="@+id/progressSignalQuality" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" style="@style/Widget.AppCompat.ProgressBar.Horizontal" />
            <Button android:id="@+id/btnPauseResume" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvPeakToPeak" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvFrequency" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvSnr" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvPi" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
