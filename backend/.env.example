# BPSync Backend - Ornek env dosyasi
# Bu dosyayi .env olarak kopyalayin

# PostgreSQL baglantisi (database klasorunden)
DATABASE_URL=postgresql://bpsync_app:bpsync_password@localhost:5432/bpsync

# Docker icinde:
# DATABASE_URL=postgresql://bpsync_app:bpsync_password@host.docker.internal:5432/bpsync

USE_MOCK_DATA=false
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=8000
DEBUG=true
