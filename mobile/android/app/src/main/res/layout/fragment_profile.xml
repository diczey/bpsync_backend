<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_indigo"
    android:orientation="vertical">

    <!-- ── Non-scrolling Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- Back + Edit/Save row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Back button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_btn_white"
                android:elevation="3dp"
                android:outlineProvider="bounds"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back"
                    android:tint="#6366F1" />
            </FrameLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Edit / Save toggle button -->
            <FrameLayout
                android:id="@+id/btnEditSave"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_btn_white"
                android:elevation="3dp"
                android:outlineProvider="bounds"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivEditSaveIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    android:tint="#6366F1" />
            </FrameLayout>
        </LinearLayout>

        <!-- Profile summary card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="#E0E7FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="24dp"
                android:paddingHorizontal="20dp">

                <!-- Avatar -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_icon_indigo"
                    android:layout_marginBottom="14dp"
                    android:elevation="6dp"
                    android:outlineProvider="bounds">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Health ID: BP2024"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── Scrollable Content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <!-- ── Personal Information Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeColor="#E0E7FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Information"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- ─ Full Name row ─ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_field_row"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_indigo"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_profile"
                                android:tint="#6366F1" />
                        </FrameLayout>

                        <!-- View mode: label + value -->
                        <LinearLayout
                            android:id="@+id/layoutViewName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FULL NAME"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/tvPersonalName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="John Doe"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <!-- Edit mode -->
                        <EditText
                            android:id="@+id/etProfileName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="gone"
                            android:background="@null"
                            android:hint="Full Name"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:inputType="textPersonName" />
                    </LinearLayout>

                    <!-- ─ Email row ─ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_field_row"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_indigo"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_email"
                                android:tint="#6366F1" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/layoutViewEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EMAIL"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/tvProfileEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="john@example.com"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etProfileEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="gone"
                            android:background="@null"
                            android:hint="Email"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:inputType="textEmailAddress" />
                    </LinearLayout>

                    <!-- ─ Phone row ─ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_field_row"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_light_indigo"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_phone"
                                android:tint="#6366F1" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/layoutViewPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PHONE"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/tvProfilePhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="+1 234 567 8900"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etProfilePhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="gone"
                            android:background="@null"
                            android:hint="Phone"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:inputType="phone" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Health Metrics Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeColor="#E0E7FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Metrics"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- Row 1: Age | Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <!-- Age tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="7dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_field_row"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_light_indigo"
                                android:layout_marginBottom="10dp">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_calendar"
                                    android:tint="#6366F1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvProfileAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="28"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#6366F1"
                                android:lineSpacingExtra="-2dp" />

                            <EditText
                                android:id="@+id/etProfileAge"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:background="@null"
                                android:gravity="center"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#6366F1"
                                android:inputType="number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="AGE"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Gender tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_field_row"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_light_pink"
                                android:layout_marginBottom="10dp">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_person"
                                    android:tint="#EC4899" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvProfileGender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Male"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#EC4899" />

                            <Spinner
                                android:id="@+id/spinnerProfileGender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:entries="@array/gender_options" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="GENDER"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Weight | Height -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <!-- Weight tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="7dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_field_row"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon_green_light"
                                android:layout_marginBottom="10dp">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_weight"
                                    android:tint="#10B981" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvProfileWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="75"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#10B981"
                                android:lineSpacingExtra="-2dp" />

                            <EditText
                                android:id="@+id/etProfileWeight"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:background="@null"
                                android:gravity="center"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#10B981"
                                android:inputType="numberDecimal" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="WEIGHT (KG)"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Height tile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="7dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/bg_field_row"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon_amber_light"
                                android:layout_marginBottom="10dp">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ruler"
                                    android:tint="#F59E0B" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvProfileHeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="178"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#F59E0B"
                                android:lineSpacingExtra="-2dp" />

                            <EditText
                                android:id="@+id/etProfileHeight"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:background="@null"
                                android:gravity="center"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#F59E0B"
                                android:inputType="number" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="HEIGHT (CM)"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Logout & Delete buttons ── -->
            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Log Out"
                android:textColor="@color/error"
                android:textStyle="bold"
                app:strokeColor="@color/error"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnDeleteAccount"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Delete Account"
                android:textColor="@color/error"
                android:textSize="12sp" />

            <!-- ── Hidden compat views ── -->
            <TextView android:id="@+id/tvProfileBmi" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvLastLogin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMemberSince" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvTotalMeasurements" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnSaveProfile" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnEditProfile" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
