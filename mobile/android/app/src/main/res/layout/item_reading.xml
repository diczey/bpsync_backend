<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeColor="#EDE9FE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ── Date & Time row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="#8B5CF6"
                    android:layout_marginEnd="5dp" />
                <TextView
                    android:id="@+id/item_reading_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mar 11, 2026"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    android:tint="#8B5CF6"
                    android:layout_marginEnd="5dp" />
                <TextView
                    android:id="@+id/item_reading_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:30"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 3 Mini Tiles: BP / BPM / Status ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- BP tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_reading_mini_tile"
                android:paddingVertical="10dp"
                android:paddingHorizontal="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_heart" android:tint="#EF4444" android:layout_marginEnd="3dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BP" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/text_hint" />
                </LinearLayout>
                <TextView
                    android:id="@+id/item_reading_bp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120/80"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- BPM tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_reading_mini_tile"
                android:paddingVertical="10dp"
                android:paddingHorizontal="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_pulse" android:tint="#EC4899" android:layout_marginEnd="3dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BPM" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="@color/text_hint" />
                </LinearLayout>
                <TextView
                    android:id="@+id/item_reading_hr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="72"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- Status tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_reading_mini_tile"
                android:paddingVertical="10dp"
                android:paddingHorizontal="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_hint"
                    android:layout_marginBottom="6dp" />
                <TextView
                    android:id="@+id/item_reading_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_badge_status_normal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Divider + Detail row ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EDE9FE"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/item_reading_systolic_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Systolic: -- mmHg"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/item_reading_diastolic_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Diastolic: -- mmHg"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
